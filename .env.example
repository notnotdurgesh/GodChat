# Root-level .env example for local development;
# Used by docker compose and local scripts.

# Backend settings
GEMINI_API_KEY=
MONGODB_URI=mongodb://mongo:27017/fschchat
MONGODB_DB=fschchat
DEMO_MODE=true
BACKEND_PORT=5001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional technologies
REDIS_URL=

# Frontend settings (Vite)
VITE_BACKEND_URL=http://localhost:5001
