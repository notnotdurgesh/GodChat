{
  "name": "jellyfsch-monorepo",
  "private": true,
  "description": "Monorepo for the jellyfsch frontend and unified backend",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev-runner.cjs",
    "dev:turbo": "docker compose up -d mongo && npx turbo run dev --filter=frontend --filter=backend",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo",
    "build": "npx turbo run build",
    "lint": "npx turbo run lint",
    "install-all": "npm install"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2",
    "turndown": "^7.2.2"
  }
}
